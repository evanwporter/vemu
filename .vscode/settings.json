    "--completion-style=detailed",
    "--header-insertion=iwyu",
    "--query-driver=/run/current-system/sw/bin/clang++,/run/current-system/sw/bin/g++,/nix/store/*/bin/clang++,/nix/sto       re/*/bin/g++,/nix/store/*devkitARM*/opt/devkitpro/devkitARM/bin/arm-none-eabi-*"
    // "--completion-style=detailed",
    // "--header-insertion=never"
  ],
  "cmake.ctest.testExplorerIntegrationEnabled": false,
  "slang.path": "/home/evanp/slang-server/build/debug/bin/slang-server",
