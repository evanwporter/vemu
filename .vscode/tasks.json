{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build GBA (debug)",
            "type": "shell",
            "command": "nix",
            "args": [
                "develop",
                "--command",
                "cmake",
                "--build",
                "${workspaceFolder}/build/debug",
                "--target",
                "gba",
                "-j2"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
