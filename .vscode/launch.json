    "version": "0.2.0",
    "configurations": [
        {
            "name": "GBA",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build GBA (debug)",
            "program": "${workspaceFolder}/build/debug/cores/gba/sim/gba",
            "args": [
                // "${workspaceFolder}/tests/libtonc-examples/bin/mode3_vert.gba",
                // "${workspaceFolder}/tests/gba-tests/arm/arm.gba", 
                "${workspaceFolder}/tests/gba-tests/ppu/hello.gba",
                "--log-level",
                "none"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/nix/store/vjqdb2dm7b51w7jmxkj1dmkvh9vwvf3d-gdb-17.2/bin/gdb",
            "externalConsole": false,
            // "logging": {
            //     "engineLogging": true
            // }
        },
        {
            "name": "(Windows) Cemu",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/cemu/cemu.exe",
            "args": [
